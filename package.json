{
  "name": "visual-novel-editor",
  "productName": "Visual Novel Editor (Web)",
  "version": "1.0.0",
  "description": "Visual Novel Editor — web edition: the editor runs in your browser with a small local Node.js server. Story flow graph, scene composition, timeline animation, procedural effects, visual scripting, modules and one-click game export.",
  "license": "MIT",
  "private": true,
  "author": "Visual Novel Editor contributors",
  "homepage": "https://github.com/D4eee/Visual-Novel-Editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/D4eee/Visual-Novel-Editor.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch --dev",
    "start": "npm run build && node dist/server.js",
    "serve": "npm run build && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check-i18n": "node scripts/check-i18n.mjs",
    "pack-module": "node scripts/pack-module.mjs",
    "fetch-runtimes": "node scripts/fetch-runtime-templates.mjs",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "app:web": "npm run build && node scripts/package-web.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "resedit": "^2.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "typescript": "6.0.3"
  }
}
