{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@vne/core": ["./packages/core/src/index.ts"],
      "@vne/runtime": ["./packages/runtime/src/index.ts"],
      "@vne/sdk": ["./sdk/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "sdk/src"]
}
